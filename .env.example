# Credentials are loaded from shiadata-rag/.env by default (SHIADATA_RAG_ENV).
# Set them here only if you want this project to override the RAG file.

# SHIADATA_RAG_ENV=../shiadata-rag/.env
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# GOOGLE_API_KEY1=
# GOOGLE_API_KEY2=
# GOOGLE_API_KEY3=

GEMINI_MODEL=gemini-3.6-flash
GEMINI_MODELS=gemini-3.6-flash
GEMINI_MIN_INTERVAL_MS=20000
EMBEDDING_MODEL=text-embedding-3-small
LOG_LEVEL=INFO
